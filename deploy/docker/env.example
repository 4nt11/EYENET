# Copy to deploy/docker/.env and edit. compose reads .env automatically.

# Host port to publish the API on (container always listens on 8443).
EYENET_API_PORT=8443

# CORS allowlist for the frontend origin(s), comma-separated. Empty = no CORS.
# e.g. https://eyenet.example.org  (dev: http://localhost:5173,http://localhost:5180)
EYENET_CORS_ORIGINS=

# Prometheus /v1/metrics exposition (1 = on, requires read:metrics scope to scrape).
EYENET_METRICS_ENABLED=1

# --- collectors profile only ---
# Which pool identity + source this collector instance drives.
EYENET_IDENTITY=scout01
EYENET_COLLECTOR_TYPE=telegram
