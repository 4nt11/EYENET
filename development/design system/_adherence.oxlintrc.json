{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/console/**",
              "components/data/**",
              "components/status/**",
              "ui_kits/eyenet/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuditRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|actor|verb|target|detail|tamper|children|style|key|ref|className|style|children)$/]",
        "message": "<AuditRow> doesn't accept that prop. Declared props: time, actor, verb, target, detail, tamper, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:critical|high|medium|low|neutral)$/]",
        "message": "<Badge> tone must be one of 'critical' | 'high' | 'medium' | 'low' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|icon|children|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, icon, children, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|destructive|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'destructive' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:caseId|title|tier|tierLabel|actor|updated|openCount|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CaseCard> doesn't accept that prop. Declared props: caseId, title, tier, tierLabel, actor, updated, openCount, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:critical|high|medium|low|neutral)$/]",
        "message": "<CaseCard> tier must be one of 'critical' | 'high' | 'medium' | 'low' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|width|align|mono|render|key|ref|className|style|children)$/]",
        "message": "<DataColumn> doesn't accept that prop. Declared props: key, header, width, align, mono, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventFeedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|kind|label|message|source|fresh|style|key|ref|className|style|children)$/]",
        "message": "<EventFeedItem> doesn't accept that prop. Declared props: time, kind, label, message, source, fresh, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventFeedItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:info|observe|alert|system)$/]",
        "message": "<EventFeedItem> kind must be one of 'info' | 'observe' | 'alert' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|mono|tone|key|ref|className|style|children)$/]",
        "message": "<EvidenceItem> doesn't accept that prop. Declared props: label, value, mono, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|critical)$/]",
        "message": "<EvidenceItem> tone must be one of 'default' | 'accent' | 'critical'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
