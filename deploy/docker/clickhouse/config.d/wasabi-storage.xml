<!-- Wasabi (S3-compatible) tiered storage for the stealer ULP corpus.
     Pattern: Wasabi is the cold primary, local disk is a bounded cache.
     Opt-in per table via `SETTINGS storage_policy='wasabi_primary'`;
     anything that does not opt in stays on the default local disk.

     Credentials are injected from env vars (from_env) so no secrets live
     in the XML. See deploy/docker/.env.example for the full variable set.

     Tested on ClickHouse 24.8. The `cache` disk type wraps the s3 disk
     and transparently serves hot parts from the local SSD. -->
<clickhouse>
    <storage_configuration>
        <disks>
            <!-- The actual Wasabi backing. The endpoint must end with `/` and
                 include the bucket path prefix where CH will write parts. -->
            <wasabi_s3>
                <type>s3</type>
                <endpoint from_env="EYENET_WASABI_ENDPOINT"/>
                <access_key_id from_env="EYENET_WASABI_ACCESS_KEY_ID"/>
                <secret_access_key from_env="EYENET_WASABI_SECRET_ACCESS_KEY"/>
                <!-- Wasabi is S3v4; region embedded in the hostname is enough. -->
                <region from_env="EYENET_WASABI_REGION"/>
                <!-- Metadata path is where CH stores the local "part -> s3 keys"
                     map. Separate from data so a cache wipe does not orphan
                     parts. -->
                <metadata_path>/var/lib/clickhouse/disks/wasabi_s3/</metadata_path>
                <!-- Default s3 skip_access_check is true in 24.8; leaving it
                     so a WAN blip at boot does not kill CH. -->
            </wasabi_s3>

            <!-- Local cache wrapping the s3 disk. Reads check cache first,
                 misses fetch from Wasabi + populate. Writes go straight to
                 s3 (CH enforces write-through on s3-backed cache). -->
            <wasabi_cache>
                <type>cache</type>
                <disk>wasabi_s3</disk>
                <path>/var/lib/clickhouse/wasabi-cache/</path>
                <!-- 10 GiB. Bump when the SSD has headroom + hot-set grows. -->
                <max_size>10737418240</max_size>
            </wasabi_cache>
        </disks>

        <policies>
            <!-- Opt-in policy. Tables that declare this get Wasabi-backed
                 storage with the local cache in front. Everything else
                 (system tables, ad-hoc created tables) uses `default`. -->
            <wasabi_primary>
                <volumes>
                    <main>
                        <disk>wasabi_cache</disk>
                    </main>
                </volumes>
            </wasabi_primary>
        </policies>
    </storage_configuration>
</clickhouse>
