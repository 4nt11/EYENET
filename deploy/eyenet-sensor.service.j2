[Unit]
Description=EYENET stylometric sensor (BEHAVE-TEXT primitive dispatch)
Documentation=https://github.com/4nt11/EYENET
After=network-online.target eyenet-nats.service
Wants=network-online.target eyenet-nats.service
PartOf=eyenet.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
WorkingDirectory={{ install_dir }}
EnvironmentFile=-{{ install_dir }}/.env.local
Environment=EYENET_DATA_DIR={{ data_dir }}
Environment=EYENET_SYSTEM_LOGS=/var/log/eyenet/eyenet.sensor.log
# --profile stylometric loads spaCy es_core_news_sm (~13MB, auto-fetched on first
# run -> needs outbound network the first time). 'skeleton' is the no-op profile.
ExecStart={{ venv_dir }}/bin/eyenet sensor \
    --profile {{ sensor_profile | default('stylometric') }} \
    --data-dir {{ data_dir }} \
    --nats-url {{ nats_url | default('nats://127.0.0.1:4222') }}
StandardOutput=append:/var/log/eyenet/eyenet.sensor.log
StandardError=append:/var/log/eyenet/eyenet.sensor.log

CapabilityBoundingSet=
AmbientCapabilities=

# Security hardening
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# spaCy caches the model under the venv/site-packages or ~/.cache; keep install_dir
# writable for the first-run model fetch (or pre-bake the model at build time).
ReadWritePaths={{ data_dir }} {{ install_dir }} /var/log/eyenet

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
