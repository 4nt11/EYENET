[Unit]
Description=EYENET collector for identity %i
Documentation=https://github.com/4nt11/EYENET
After=network-online.target eyenet-nats.service
Wants=network-online.target eyenet-nats.service
# Instanced: one collector per pool identity (EYENET is plural from day one).
# NOT a member of eyenet.target's Wants= — enable per identity instead:
#   systemctl enable --now eyenet-collector@<identity>.service
# so the target's start/stop does not fan out to every identity implicitly.
PartOf=eyenet.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
WorkingDirectory={{ install_dir }}
# Per-identity config: collector type, optional proxy, etc. Drop
# COLLECTOR_TYPE=telegram|matrix (+ overrides) at the path below. The leading '-'
# makes it optional; COLLECTOR_TYPE then defaults to telegram.
EnvironmentFile=-{{ install_dir }}/.env.local
EnvironmentFile=-/etc/eyenet/collectors/%i.env
Environment=EYENET_DATA_DIR={{ data_dir }}
Environment=COLLECTOR_TYPE=telegram
Environment=EYENET_SYSTEM_LOGS=/var/log/eyenet/eyenet.collector.%i.log
ExecStart={{ venv_dir }}/bin/eyenet collector \
    --identity %i \
    --type ${COLLECTOR_TYPE} \
    --data-dir {{ data_dir }} \
    --nats-url {{ nats_url | default('nats://127.0.0.1:4222') }}
StandardOutput=append:/var/log/eyenet/eyenet.collector.%i.log
StandardError=append:/var/log/eyenet/eyenet.collector.%i.log

# Collectors reach Telegram/Matrix (+ optional proxy) — outbound network only.
CapabilityBoundingSet=
AmbientCapabilities=

# Security hardening
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# data_dir (DB + cursors) and the identities dir (session files) must be writable.
ReadWritePaths={{ data_dir }} {{ identities_dir | default(data_dir + '/identities') }} /var/log/eyenet

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
