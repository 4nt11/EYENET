#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/lib/common.sh"
. "$SCRIPT_DIR/lib/secret_name_guard.sh"

# Activate uv-managed venv if not active and one exists.
if [[ -z "${VIRTUAL_ENV:-}" ]] && [[ -f .venv/bin/activate ]]; then
  # shellcheck disable=SC1091
  . .venv/bin/activate
fi

require ruff
require mypy
require bandit
require detect-secrets
require deptry
require pytest

mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR)

# FIRST gate: filename-pattern guard. Runs before any other tool so an
# obviously-dangerous file name (.abuse.*, *api_key*, *.pem, etc.) blocks
# the commit without waiting for the long test / type / audit chain.
step "secret filename guard (name-based, backstops detect-secrets)"
if [[ ${#STAGED[@]} -gt 0 ]]; then
  secret_name_guard "${STAGED[@]}" || abort "dangerous filename pattern in staged files"
fi
ok "no dangerous filenames"
PY_STAGED=()
EYENET_PY=()
for f in "${STAGED[@]:-}"; do
  [[ "$f" == *.py ]] && PY_STAGED+=("$f")
  [[ "$f" == eyenet/*.py || "$f" == eyenet/**/*.py ]] && EYENET_PY+=("$f")
done

step "ruff format --check (staged)"
if [[ ${#PY_STAGED[@]} -gt 0 ]]; then
  ruff format --check "${PY_STAGED[@]}" || abort "ruff format failed — run: ruff format ."
fi
ok "format clean"

step "ruff check (staged)"
if [[ ${#PY_STAGED[@]} -gt 0 ]]; then
  ruff check "${PY_STAGED[@]}"
fi
ok "lint clean"

step "mypy --strict (staged)"
if [[ ${#PY_STAGED[@]} -gt 0 ]]; then
  mypy --strict --no-incremental "${PY_STAGED[@]}"
fi
ok "types clean"

step "bandit (staged eyenet/*)"
if [[ ${#EYENET_PY[@]} -gt 0 ]]; then
  bandit -c pyproject.toml --quiet "${EYENET_PY[@]}"
fi
ok "bandit clean"

step "detect-secrets (CRITICAL — identity-pool blobs / age keys must not slip in)"
# Calibration fixtures (rutify_calibration_baseline.json, rutify_labels.toml)
# legitimately carry sha256 content hashes — corpus_sha256 pins and self_hash
# integrity stamps. They regenerate on every grid run, so tracking them via
# the baseline would mean re-running detect-secrets scan after each
# calibration. Excluding the directory is sturdier and matches the M5 design
# (only derived hashes + labels live there; never message bodies or
# identity-pool blobs).
SECRET_EXCLUDE='^tests/fixtures/calibration/'
if [[ ${#STAGED[@]} -gt 0 ]]; then
  detect-secrets-hook --baseline .secrets.baseline --exclude-files "$SECRET_EXCLUDE" "${STAGED[@]}"
fi
ok "no secrets"

step "deptry"
deptry eyenet
ok "deps clean"

step "pytest AFFECTED tests only (testmon); full suite + coverage gate run at pre-push"
# The pre-commit/pre-push split this file used to promise, now landed: the
# per-commit gate runs ONLY the tests whose covered code changed (testmon,
# tracked in .testmondata, git-ignored + per-machine), and the coverage floor
# + delta-no-drop moved wholesale to pre-push. The commit loop stays fast; the
# thorough gate runs once per push, where it belongs.
#
# Flag notes (all three are load-bearing, do not drop one):
#   --no-cov        testmon drives coverage.py itself; pytest-cov (baked into
#                   addopts as --cov=eyenet) would fight it for the tracer.
#   -o addopts=""   clears the baked `-m "unit or contract"` (testmon DISABLES
#                   its own selection the moment any -m is present) and the
#                   --cov flags, in one move. --timeout is re-added explicitly
#                   since the cleared addopts carried it.
#   first run       a cold .testmondata primes the map (runs everything once);
#                   every commit after reruns only what your change touched.
# e2e tests self-skip without EYENET_E2E=1, so an untouched-but-affected e2e
# never actually executes here.
pytest --testmon --no-cov -o addopts="" --timeout=30 -q --no-header -x

ok "pre-commit OK"
