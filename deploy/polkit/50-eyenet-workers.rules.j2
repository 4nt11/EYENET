// Allow members of the '{{ group }}' group to manage EYENET systemd units
// (start / stop / restart / reload) without a password prompt.
//
// Scope is locked to units matching `eyenet-<name>.service`,
// `eyenet-collector@<id>.service`, or the `eyenet.target` grouping unit. Any
// other unit is unaffected and still goes through default polkit policy.
//
// The group name is rendered at `eyenet deploy` time from --group (default
// `eyenet`); dev boxes that pass --group $USER get a rule matching the
// operator's own login group.
//
// Install: /etc/polkit-1/rules.d/50-eyenet-workers.rules

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit &&
            /^eyenet-[a-z]+(@[^.]+)?\.service$|^eyenet\.target$/.test(unit) &&
            subject.isInGroup("{{ group }}")) {
            return polkit.Result.YES;
        }
    }
});
