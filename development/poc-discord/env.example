# Discord read-probe secrets. Copy to .env (gitignored) and fill DISCORD_TOKEN.
# Everything here is a per-account / per-browser credential. Never commit the real .env.

# User token = the exact Authorization header value (user tokens have NO "Bearer " prefix).
DISCORD_TOKEN=

# Full Cookie header value from the same browser session (cf_clearance is bound to
# that browser's TLS fingerprint + UA + IP, and expires — remint via FlareSolverr).
DISCORD_COOKIE=

# Client fingerprint (base64 X-Super-Properties + X-Installation-Id) from the same session.
DISCORD_SUPER_PROPERTIES=
DISCORD_INSTALLATION_ID=

# Prototype target.
DISCORD_CHANNEL_ID=1561531968737247415
DISCORD_GUILD_ID=1561531968116625509

# Optional overrides.
DISCORD_IMPERSONATE=firefox147
DISCORD_TIMEZONE=America/Santiago
FLARESOLVERR_URL=http://localhost:8191/v1
