{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "EYENET API metrics source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "EYENET API — Observability",
  "uid": "eyenet-api",
  "tags": ["eyenet", "api", "observability"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "${DS_PROMETHEUS}" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API healthy",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "targets": [{ "expr": "max(eyenet_api_healthy)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Audit publish failures (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [{ "expr": "increase(eyenet_api_audit_publish_failures_total[5m])", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trace-missing SLI (15m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } } },
      "targets": [{ "expr": "increase(eyenet_api_trace_propagation_missing_total[15m])", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Open SSE connections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(eyenet_api_sse_connections)", "refId": "A" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum by (route) (rate(eyenet_api_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request latency p95 by route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (route, le) (rate(eyenet_api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "5xx ratio",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "sum(rate(eyenet_api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(eyenet_api_requests_total[5m])), 1)", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Auth events by outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "sum by (event, outcome) (rate(eyenet_api_auth_events_total[5m]))", "legendFormat": "{{event}}/{{outcome}}", "refId": "A" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "SSE delivered vs dropped",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum by (stream) (rate(eyenet_api_sse_events_delivered_total[5m]))", "legendFormat": "delivered {{stream}}", "refId": "A" },
        { "expr": "sum by (stream) (rate(eyenet_api_sse_events_dropped_total[5m]))", "legendFormat": "dropped {{stream}}", "refId": "B" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "SSE delivery lag p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (stream, le) (rate(eyenet_api_sse_delivery_lag_seconds_bucket[5m])))", "legendFormat": "{{stream}}", "refId": "A" }
      ]
    }
  ]
}
