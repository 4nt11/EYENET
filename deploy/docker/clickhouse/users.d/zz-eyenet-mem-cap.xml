<!--
  v1.3.4.3 operator-profile overrides for the eyenet user.

  max_memory_usage: per-query cap. The CH container runs with mem_limit 8g
  (cgroup) so max_server_memory_usage is auto-set to 0.9x (~7.2 GiB).
  Without a per-query cap, a single heavy classifier/API query can hog
  the full server budget and starve concurrent gotractor flushes with
  code: 241. 4 GiB leaves ~3.2 GiB headroom for ingest + merges.
  History: v1.3.4.3 shipped 8 GiB vs. a 4 GiB cgroup (unsafe mismatch);
  2026-11-21 live patch dropped per-query to 2.5 GiB; v1.3.12.1 raised
  container to 8 GiB and per-query to 4 GiB for reindex headroom.

  allow_experimental_refreshable_materialized_view: 24.8 gates refreshable
  MVs behind this flag. victim_counts_refresh depends on it.
-->
<clickhouse>
  <profiles>
    <default>
      <max_memory_usage>4000000000</max_memory_usage>
      <allow_experimental_refreshable_materialized_view>1</allow_experimental_refreshable_materialized_view>
      <!-- v1.3.10: belt-and-suspenders with the sink's progress drain
           callbacks. 1800s covers any realistic single-archive INSERT. -->
      <send_timeout>1800</send_timeout>
      <receive_timeout>1800</receive_timeout>
    </default>
  </profiles>
</clickhouse>
