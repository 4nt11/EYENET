# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
.eggs/

# Envs
.venv/
venv/
.env
.env.*
!.env.example

# uv
uv.lock        # commit this if you want — leaving uncommitted in v0
.uv-cache/

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
.benchmarks/
.hypothesis/
bench.json

# Type checkers
.mypy_cache/
.ruff_cache/
.dmypy.json

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# OPSEC — these MUST NEVER be committed
identities.toml
identities/
# Exception: this is a code path under eyenet/, not an OPSEC blob
!eyenet/api/v1/identities/
*.session
*.session-journal
sessions/
*.age
*.age.key
*.key
secrets/
.secrets/
# Live operator config — only config.example.toml is tracked.
config.toml
config.local.toml

# Operational artifacts (data, not code)
# Note: gitignore re-inclusion requires negating each directory level — use
# `data/*` so subdirs can be selectively whitelisted below.
data/*
# INGEOTEC regional-spanish-models vocab — LFS-tracked, used by
# scripts/build_regional_markers.py to regenerate _regional_markers.py
!data/ingeotec/
storage/*.db
storage/*.db-*
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
.eyenet-init.lock
logs/
traces/
spans.ndjson*

# Calibration corpora — operator-controlled, not in source
tests/fixtures/corpora/rutify*
tests/fixtures/corpora/*.real.jsonl
# Raw corpus dumps in projroot — operator-only, never committed.
/rutify-*.jsonl
/rutify-users.json
/rutify-users.json.bak
# Stray planning artifacts emitted before plan-mode workflow kicked in
/M5_PLAN.md
