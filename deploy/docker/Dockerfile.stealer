# EYENET stealer-log ULP processor image — extends the base with the archive +
# extraction toolchain for eyenet/stealer/. Opt-in (compose `stealer` profile); the
# core stack ships without it.
#
#   docker build -f deploy/docker/Dockerfile.stealer -t eyenet:stealer ../..
#
# - ulpextract: the prod Go extractor, built from the in-package source (wheels-in)
#   into /usr/local/bin and pointed at via EYENET_ULPEXTRACT_BIN.
# - unar (The Unarchiver, Debian main): ONE extractor for every container a dump ships
#   in — rar/rar5, 7z, zip, tar, tar.gz/.xz, gz — with password support. Opens the
#   RAR5-encrypted-data variant 7z cannot, and (unlike unrar) isn't rar-only + is in main.
# - clickhouse-connect: the creds sink (optional dep, stealer profile only).

FROM golang:1.22-bookworm AS gobuild
WORKDIR /src
COPY eyenet/stealer/ulpextract/ ./
RUN CGO_ENABLED=0 go build -o /ulpextract ./ulpextract.go

FROM eyenet:base

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends unar \
 && rm -rf /var/lib/apt/lists/*
RUN /opt/venv/bin/pip install --no-cache-dir 'clickhouse-connect>=0.8'
COPY --from=gobuild /ulpextract /usr/local/bin/ulpextract
ENV EYENET_ULPEXTRACT_BIN=/usr/local/bin/ulpextract
USER eyenet
