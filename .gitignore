# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
.eggs/

# Envs
.venv/
venv/
.env
.env.*
!.env.example

# Secret-adjacent files: defense in depth against ad-hoc `.servicename`
# dotfiles stashing API keys, auth-key bags per vendor, etc. Add a specific
# `!` exception if a file is legitimately NOT a secret (e.g. a public
# `.vendorname.yaml` config). Prefer putting secrets at ~/.config/ paths
# that are OUTSIDE the repo entirely.
.abuse*
.aws
.authinfo
.netrc
.pgpass
*api_key*
*apikey*
*api-key*
*secret*
*_token
*_token.*
*passwd*
*.pem
*.p12
*.pfx
# Our own secret-detection machinery and the detect-secrets baseline file
# do not contain secrets. Opt them back in explicitly. Later rules override
# earlier ones, so these negations re-include the matched paths.
!.githooks/
!.githooks/**
!.secrets.baseline
# Backup copies with secrets often get named *.bak or *.old
.env.bak
.env.old
# Tilde/vim swap files sometimes leak content from secret files
*.env.swp
*.env~

# uv
uv.lock        # commit this if you want — leaving uncommitted in v0
.uv-cache/

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
.benchmarks/
.hypothesis/
bench.json

# Type checkers
.mypy_cache/
.ruff_cache/
.dmypy.json

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# OPSEC — these MUST NEVER be committed
identities.toml
identities/
# Exception: this is a code path under eyenet/, not an OPSEC blob
!eyenet/api/v1/identities/
# Exception: the identities handler test dir is source, not an OPSEC blob
# (scope to .py so __pycache__ stays ignored — a bare ** re-includes it)
!tests/unit/api/v1/identities/
!tests/unit/api/v1/identities/*.py
# Exception: the frontend route dir is Svelte source, not an OPSEC blob
!eyenet-fe/src/routes/identities/
!eyenet-fe/src/routes/identities/**
*.session
*.session-journal
sessions/
*.age
*.age.key
*.key
secrets/
.secrets/
# Live operator config — only config.example.toml is tracked.
config.toml
config.local.toml

# Operational artifacts (data, not code)
# Note: gitignore re-inclusion requires negating each directory level — use
# `data/*` so subdirs can be selectively whitelisted below.
data/*
# INGEOTEC regional-spanish-models vocab — LFS-tracked, used by
# scripts/build_regional_markers.py to regenerate _regional_markers.py
!data/ingeotec/
storage/*.db
storage/*.db-*
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
.eyenet-init.lock
logs/
# The Cases "Logs" route is source, not runtime log output — keep it tracked.
!eyenet-fe/src/routes/cases/logs/
!eyenet-fe/src/routes/cases/logs/**
traces/
spans.ndjson*

# Calibration corpora — operator-controlled, not in source
tests/fixtures/corpora/rutify*
tests/fixtures/corpora/*.real.jsonl
# Raw corpus dumps in projroot — operator-only, never committed.
/rutify-*.jsonl
/rutify-users.json
/rutify-users.json.bak
# Stray planning artifacts emitted before plan-mode workflow kicked in
/M5_PLAN.md

# Claude Code session + worktrees
.claude/

# CTI data
investigations/
eyenet/stealer/ulpextract/ulpextract

# generated prod provenance stamp (regenerated on deploy by stamp-commit.sh)
deploy/docker/commit.json

# private deployment topology diagrams (not public, never commit)
development/deploy-single-host.*
development/deploy-multi-host.*

# model weights live on HuggingFace (4nt11/eyenet-incident), never commit
*.safetensors

# bun is the package manager here; npm cruft must never come back
package-lock.json

# design exports (FE drawer mockups, HTML + assets); reference only, not shipped
development/design-*/

# pytest-testmon local test-selection DB (per-machine, never shared)
.testmondata
