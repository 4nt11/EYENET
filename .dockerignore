# Build context is the repo root (deploy/docker/compose.yaml). Keep it lean:
# the images only need pyproject.toml, PLAN.md, eyenet/, and deploy/docker/nsjail.
.git
.github
.claude
**/__pycache__
**/*.pyc
.venv
venv
.mypy_cache
.ruff_cache
.pytest_cache
node_modules
# eyenet-fe: the edge image builds the SPA from its source, so keep it IN context ~
# only the heavy/generated dirs stay out.
eyenet-fe/node_modules
eyenet-fe/build
eyenet-fe/.svelte-kit
tests
development
data
*.db
*.sqlite*
build
dist
*.egg-info
.coverage*
htmlcov
# stray untracked artifacts (never belong in an image)
DSR-*.docx
classifier_corpus.py
docs-*.jsonl
ruleset-additive.toml
