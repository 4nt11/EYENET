[Unit]
Description=EYENET message bus (NATS server)
Documentation=https://docs.nats.io/
After=network-online.target
Wants=network-online.target
# Bind lifecycle to the target: Wants= only propagates START; PartOf= propagates
# STOP/RESTART so `systemctl stop eyenet.target` brings NATS down too.
PartOf=eyenet.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
WorkingDirectory={{ install_dir }}
EnvironmentFile=-{{ install_dir }}/.env.local
Environment=EYENET_SYSTEM_LOGS=/var/log/eyenet/eyenet.nats.log
# Native single-binary nats-server. Core NATS pub/sub only — EYENET does not use
# JetStream (SSE replay is served from storage, not the bus), so there is no
# stream store to persist and the process is stateless. Bind loopback by default;
# widen --addr only behind TLS + auth (see DEPLOY.md).
ExecStart={{ nats_bin | default('/usr/local/bin/nats-server') }} \
    --addr {{ nats_host | default('127.0.0.1') }} \
    --port {{ nats_port | default(4222) }} \
    --name eyenet-nats
# Readiness gate: block start-up completion until the port accepts a connection
# so After=eyenet-nats.service waiters do not race a not-yet-listening bus.
ExecStartPost=/bin/sh -c 'for i in $$(seq 50); do (exec 3<>/dev/tcp/{{ nats_host | default("127.0.0.1") }}/{{ nats_port | default(4222) }}) 2>/dev/null && exit 0; sleep 0.1; done; exit 1'
StandardOutput=append:/var/log/eyenet/eyenet.nats.log
StandardError=append:/var/log/eyenet/eyenet.nats.log

# No privileged operations — a plain TCP listener.
CapabilityBoundingSet=
AmbientCapabilities=

# Security hardening
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/log/eyenet

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
