# Copy to deploy/docker/.env (gitignored) and fill in. Compose reads this file.

# Postgres password for the operating store (M-postgres cutover). Generate a
# strong one, e.g.:  python -c "import secrets; print(secrets.token_hex(24))"
# Used by the postgres + pgbouncer services and the EYENET_PG_URL/EYENET_PG_DDL_URL
# connection strings. Keep it alphanumeric (it is embedded in a URL unencoded).
EYENET_PG_PASSWORD=

# Optional overrides (defaults in compose.yaml):
#   EYENET_STORAGE_TYPE=postgres   # flip to sqlite for rollback
#   EYENET_API_PORT=8443
#   EYENET_CORS_ORIGINS=
