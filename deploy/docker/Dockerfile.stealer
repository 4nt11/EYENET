# EYENET stealer-log ULP processor image: extends the base with the archive
# toolchain for eyenet/stealer/. Opt-in (compose `stealer` profile); the
# core stack ships without it.
#
#   docker build -f deploy/docker/Dockerfile.stealer -t eyenet:stealer ../..
#
# - gotractor: the rule-driven DSL extractor (records table) + the wallet-
#   vault LevelDB pass. The stealer processor's daemon mode calls this
#   binary one-shot per archive via GotractorDaemon.
# Archive extractors, three-tier dispatch (see eyenet/stealer/pipeline.py):
# - unrar (Debian non-free): RAR5-native decoder. Measured 25x faster than
#   unar on the Khazan 2GB prod corpus (10.8s vs 272s).
# - 7zip (Debian main, provides /usr/bin/7zz): multithreaded AES + SIMD CRC
#   for 7z/zip/tar/gz/xz. Does NOT ship a RAR codec in the Debian build,
#   so RAR archives route to unrar.
# - unar (Debian main): LAST-RESORT fallback for the handful of archives
#   neither tool opens. Opt-out via EYENET_STEALER_EXTRACT_FALLBACK=disable;
#   see development/UNAR_MIGRATION_SCOPE.md.
# - clickhouse-connect: the records sink (optional dep, stealer profile only).

FROM golang:1.26-bookworm AS gobuild

# gotractor: go.mod requires 1.26 (added via syndtr/goleveldb idb_cmp1
# comparer work).
WORKDIR /src/gotractor
COPY eyenet/stealer/gotractor/ ./

# Build identity: embed version + git SHA + build time via -ldflags so
# the running binary is traceable (`gotractor --version`, logged on
# daemon boot, returned in the stats command). EYENET_VERSION comes
# from the compose build arg; EYENET_GIT_SHA is injected the same way,
# falling back to 'unknown' for a vanilla `docker build`. BUILD_TIME
# is stamped at image build.
ARG EYENET_VERSION=dev
ARG EYENET_GIT_SHA=unknown
RUN CGO_ENABLED=0 go build \
    -ldflags "-s -w \
      -X main.buildVersion=${EYENET_VERSION} \
      -X main.buildCommit=${EYENET_GIT_SHA} \
      -X main.buildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /gotractor .

FROM eyenet:base

USER root
# unrar is in non-free; add its component to the existing debian.sources
# (matches signed-by key of main), install, then revert. Keeps later
# apt-get calls free of non-free noise. Fallback to editing sources.list
# for images where debian.sources isn't present.
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/^Components: main/Components: main non-free non-free-firmware/' \
            /etc/apt/sources.list.d/debian.sources; \
    else \
        sed -i 's/ main$/ main non-free non-free-firmware/' /etc/apt/sources.list; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends 7zip unrar unar \
 && if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/^Components: main non-free non-free-firmware/Components: main/' \
            /etc/apt/sources.list.d/debian.sources; \
    else \
        sed -i 's/ main non-free non-free-firmware$/ main/' /etc/apt/sources.list; \
    fi \
 && rm -rf /var/lib/apt/lists/*
RUN /opt/venv/bin/pip install --no-cache-dir 'clickhouse-connect>=0.8'
COPY --from=gobuild /gotractor /usr/local/bin/gotractor
ENV EYENET_GOTRACTOR_BIN=/usr/local/bin/gotractor
# Re-stamp the version label: FROM eyenet:base carries base's value, baked
# at base-build time; re-declaring here stamps the stealer image with THIS
# deploy's version.
ARG EYENET_VERSION=dev
LABEL org.opencontainers.image.version=$EYENET_VERSION
USER eyenet
